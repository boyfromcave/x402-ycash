{
  "name": "x402-ycash-example-merchant-express",
  "version": "0.0.0",
  "private": true,
  "description": "Example: an Express server selling routes for YEC over x402, verified and settled by the Ycash facilitator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test --exclude '**/devnet/**'",
    "test:devnet": "vitest run --dir test/devnet --passWithNoTests --no-file-parallelism --testTimeout=600000 --hookTimeout=600000"
  },
  "dependencies": {
    "@x402/core": "~2.28.0",
    "@x402/express": "~2.28.0",
    "express": "^5.1.0",
    "x402-ycash-mechanism": "0.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.4",
    "@x402/fetch": "~2.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "x402-ycash-facilitator": "0.0.0"
  }
}
