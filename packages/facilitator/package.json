{
  "name": "x402-ycash-facilitator",
  "version": "0.0.0",
  "description": "A standalone x402 facilitator for Ycash: POST /verify, POST /settle, GET /supported, GET /healthz",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "x402-ycash-facilitator": "./dist/main.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@x402/core": "~2.28.0",
    "express": "^5.1.0",
    "x402-ycash-mechanism": "0.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
